def web_lijst(db, q, project):
    projecten = [r[0] for r in db.execute("SELECT DISTINCT cwd FROM sessies WHERE cwd IS NOT NULL ORDER BY cwd")]
    keuze = "".join(f'<option value="{e(p)}"{" selected" if p == project else ""}>{e(p.replace("/ai/workspace/", ""))}</option>'
                    for p in projecten)
    aantal = db.execute("SELECT COUNT(*) FROM sessies").fetchone()[0]
    kop = (f'<header><h1>Claude-sessies <small>{aantal} bewaard</small></h1></header>'
           f'<form class="zoek" method="get" action="./"><input name="q" value="{e(q)}" placeholder="Zoek in alle chats… (bv. supabase migratie)" autofocus>'
           f'<select name="project"><option value="">Alle mappen</option>{keuze}</select><button class="knop hoofd">Zoek</button></form>')
    if q:
        treffers = zoek(db, q, 300, project or None)
        if not treffers:
            return pagina(f"Zoeken: {q}", kop + '<p class="leeg">Niets gevonden.</p>')
        groepen = {}
        for t in treffers:
            groepen.setdefault(t["sessie"], []).append(t)
        blokken = []
        for sid, ts in groepen.items():
            t0 = ts[0]
            stukken = "".join(f'<div class="stuk"><a href="s/{e(sid)}#m{t["nr"]}">{e(t["rol"])} · {e(tijdstip(t["tijd"]))}</a> {stuk_html(t["stuk"])}</div>'
                              for t in ts[:4])
            meer = f'<div class="meta">+ {len(ts) - 4} treffers meer</div>' if len(ts) > 4 else ""
            blokken.append(f'<div class="sessie"><a href="s/{e(sid)}"><b>{e(t0["titel"] or "Sessie zonder titel")}</b></a>'
                           f'<span class="meta">{e(tijdstip(t0["eind"], True))} · {len(ts)} treffers</span>{stukken}{meer}</div>')
        return pagina(f"Zoeken: {q}", kop + f'<div class="lijst">{"".join(blokken)}</div>')
    rijen = sessies(db, 500, project or None)
    items = "".join(f'<a class="sessie" href="s/{e(r["id"])}"><b>{e(r["titel"] or "Sessie zonder titel")}</b>'
                    f'<span class="meta">{e(tijdstip(r["eind"], True))} · {e(project_naam(r))} · {r["vragen"]} vragen · {e(r["id"][:8])}</span></a>'
                    for r in rijen)
    return pagina("Claude-sessies", kop + f'<div class="lijst">{items or "<p class=leeg>Nog geen sessies.</p>"}</div>')


def web_sessie(rij):
    lijst = berichten(rij["pad"], met_tools=True)
    hervat = f"cd {shlex.quote(rij['cwd'] or '.')} && claude --resume {rij['id']}"
    balk = (f'<div class="balk"><a class="knop" href="../">← Alle sessies</a>'
            f'<a class="knop" href="{e(rij["id"])}.md">Exporteer (Markdown)</a>'
            f'<a class="knop hoofd" href="{e(rij["id"])}.overdracht">Overdrachtsnotitie</a>'
            f'<button class="knop" onclick="kopieer({e(json.dumps(hervat))},this)">Kopieer hervat-opdracht</button>'
            f'<button class="knop" onclick="kopieer({e(json.dumps(f"/sessies verder {rij["id"][:8]}"))},this)">Kopieer /sessies-opdracht</button></div>')
    kop = (f'<header><h1>{e(rij["titel"])}</h1></header><p class="meta">{e(rij["id"])} · {e(rij["cwd"] or rij["project"])} · '
           f'{e(tijdstip(rij["start"], True))} – {e(tijdstip(rij["eind"], True))}</p>')
    delen = []
    for i, b in enumerate(lijst):
        if b["rol"] == "tool":
            inv = verberg(json.dumps(b.get("invoer"), ensure_ascii=False, indent=1))[:4000]
            delen.append(f'<details class="tool" id="m{i}"><summary>🔧 {e(b["tekst"])}</summary><pre>{e(inv)}</pre>'
                         + (f'<pre>{e(b["uitkomst"])}</pre>' if b.get("uitkomst") else "") + "</details>")
        else:
            wie = "Jij" if b["rol"] == "jij" else "Claude"
            delen.append(f'<div class="bericht {b["rol"]}" id="m{i}"><div class="wie">{wie} · {e(tijdstip(b["tijd"]))}</div>{tekst_html(b["tekst"])}</div>')
    return pagina(rij["titel"] or "Sessie", kop + balk + "".join(delen))


def web(poort, adres):
    db = verbind()
    laatste = [0.0]
    verzoek = threading.Lock()  # één verbinding voor alle threads: verzoeken na elkaar afhandelen

    def vers():
        if time.time() - laatste[0] > 30:
            laatste[0] = time.time()
            bijwerken(db)

    class Handler(BaseHTTPRequestHandler):
        def stuur(self, code, inhoud, soort="text/html; charset=utf-8", extra=None):
            data = inhoud.encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", soort)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Robots-Tag", "noindex")
            for k, v in (extra or {}).items():
                self.send_header(k, v)
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            with verzoek:
                self.afhandelen()

        def afhandelen(self):
            url = urlparse(self.path)
            pad = unquote(url.path)
            qs = parse_qs(url.query)
            try:
                vers()
                if pad in ("/", ""):
                    return self.stuur(200, web_lijst(db, qs.get("q", [""])[0].strip(), qs.get("project", [""])[0]))
                m = re.fullmatch(r"/s/([0-9a-f-]{6,})(\.md|\.overdracht)?", pad)
                if m:
                    rijen = list(db.execute("SELECT * FROM sessies WHERE id LIKE ? LIMIT 2", (m.group(1) + "%",)))
                    if len(rijen) != 1:
                        return self.stuur(404, pagina("Niet gevonden", '<p class="leeg">Sessie niet gevonden. <a href="../">Terug</a></p>'))
                    rij = rijen[0]
                    if m.group(2) == ".md":
                        naam = re.sub(r"[^\w\- ]", "", rij["titel"] or "sessie")[:60].strip() or "sessie"
                        return self.stuur(200, markdown(rij), "text/markdown; charset=utf-8",
                                          {"Content-Disposition": f"attachment; filename*=UTF-8''{quote(naam)}-{rij['id'][:8]}.md"})
                    if m.group(2) == ".overdracht":
                        return self.stuur(200, overdracht(rij), "text/plain; charset=utf-8")
                    return self.stuur(200, web_sessie(rij))
                self.stuur(404, pagina("Niet gevonden", '<p class="leeg">Niet gevonden.</p>'))
            except Exception as fout:  # de pagina mag nooit omvallen door één raar transcript
                self.stuur(500, pagina("Fout", f'<p class="leeg">Er ging iets mis: {e(fout)}</p>'))

        def log_message(self, *args):
            pass

    print(f"claude-sessies: http://{adres}:{poort}/ (via code-server: /proxy/{poort}/)", file=sys.stderr)
    ThreadingHTTPServer((adres, poort), Handler).serve_forever()


