def e(t):
    return html.escape(str(t or ""), quote=True)


def stuk_html(stuk):
    return e(stuk).replace("\x02", "<mark>").replace("\x03", "</mark>")


def tekst_html(t):
    """Eenvoudige Markdown: codeblokken en `code`; de rest als platte tekst met behouden regels."""
    delen = re.split(r"```[^\n]*\n(.*?)```", t, flags=re.S)
    uit = []
    for i, deel in enumerate(delen):
        if i % 2:
            uit.append(f"<pre>{e(deel)}</pre>")
        else:
            s = e(deel)
            s = re.sub(r"`([^`\n]+)`", r"<code>\1</code>", s)
            s = re.sub(r"\*\*([^*\n]+)\*\*", r"<b>\1</b>", s)
            uit.append(f'<div class="tekst">{s}</div>')
    return "".join(uit)


