def main():
    p = argparse.ArgumentParser(prog="claude-sessies", description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="opdracht", required=True)
    a = sub.add_parser("lijst", help="recente sessies")
    a.add_argument("-n", type=int, default=20)
    a.add_argument("--project")
    a = sub.add_parser("zoek", help="zoeken in alle chats")
    a.add_argument("woorden", nargs="+")
    a.add_argument("-n", type=int, default=15)
    a.add_argument("--project")
    a = sub.add_parser("toon", help="een chat lezen")
    a.add_argument("id")
    a.add_argument("--tools", action="store_true", help="ook de tool-aanroepen tonen")
    a = sub.add_parser("export", help="chat als Markdown")
    a.add_argument("id")
    a.add_argument("-o", "--uit")
    a = sub.add_parser("overdracht", help="korte notitie om verder te gaan")
    a.add_argument("id")
    sub.add_parser("index", help="zoekindex bijwerken")
    a = sub.add_parser("web", help="webpagina starten")
    a.add_argument("--poort", type=int, default=8765)
    a.add_argument("--adres", default="127.0.0.1")
    args = p.parse_args()

    if args.opdracht == "web":
        return web(args.poort, args.adres)
    db = verbind()
    if args.opdracht == "index":
        nieuw, weg = bijwerken(db, stil=False)
        print(f"{nieuw} sessie(s) ingelezen, {weg} verwijderd; index: {DB}")
        return
    bijwerken(db)
    if args.opdracht == "lijst":
        for r in sessies(db, args.n, args.project):
            print(f"{r['id'][:8]}  {tijdstip(r['eind'])}  {project_naam(r)[:24]:24}  {r['vragen']:4} vr  {r['titel'][:80] if r['titel'] else ''}")
    elif args.opdracht == "zoek":
        treffers = zoek(db, " ".join(args.woorden), 400, args.project)
        if not treffers:
            print("Niets gevonden.")
        groepen = {}
        for t in treffers:
            groepen.setdefault(t["sessie"], []).append(t)
        for sid, ts in list(groepen.items())[:args.n]:
            print(f"\n{sid[:8]}  {tijdstip(ts[0]['eind'])}  {ts[0]['titel'][:80]}  ({len(ts)} treffers)")
            for t in ts[:3]:
                print(f"    #{t['nr']} {t['rol']}: " + t["stuk"].replace("\x02", "»").replace("\x03", "«").replace("\n", " ")[:220])
    elif args.opdracht == "toon":
        print(markdown(vind(db, args.id), met_tools=args.tools))
    elif args.opdracht == "export":
        tekst = markdown(vind(db, args.id))
        if args.uit:
            Path(args.uit).write_text(tekst, encoding="utf-8")
            print(f"Geschreven: {args.uit}")
        else:
            print(tekst)
    elif args.opdracht == "overdracht":
        print(overdracht(vind(db, args.id)))


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        pass
