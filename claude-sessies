#!/usr/bin/env python3
"""claude-sessies: Claude Code-sessies terugvinden, doorzoeken, lezen en exporteren.

Leest de transcripten die Claude Code lokaal bewaart (~/.claude/projects/<project>/<sessie>.jsonl), ook
van sessies die op claude.ai/code gearchiveerd zijn. Alleen lezen: er wordt niets aan de transcripten veranderd.

  claude-sessies lijst [-n 20] [--project woord]   recente sessies
  claude-sessies zoek <woorden> [-n 15]             zoeken in alle chats (vragen, antwoorden, tool-aanroepen)
  claude-sessies toon <id> [--tools]                een chat lezen
  claude-sessies export <id> [-o bestand.md]        chat als Markdown
  claude-sessies overdracht <id>                    korte notitie om in een nieuwe sessie verder te gaan
  claude-sessies index                              de zoekindex bijwerken (gebeurt ook vanzelf)
  claude-sessies web [--poort 8765]                 webpagina (via code-server: /proxy/8765/)

Een <id> mag een begin van het sessie-id zijn (minstens 6 tekens).
Zoekindex: $CLAUDE_SESSIES_DB (standaard ~/claude-sessies/index.db). Bekende geheimen (sleutels, tokens,
wachtwoorden) worden in de index en in alle uitvoer onleesbaar gemaakt.
"""

import argparse
import html
import json
import os
import re
import shlex
import sqlite3
import sys
import threading
import time
from datetime import datetime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, quote, unquote, urlparse

HOME = Path(os.environ.get("HOME", "/config"))
PROJECTEN = Path(os.environ.get("CLAUDE_CONFIG_DIR", HOME / ".claude")) / "projects"
DB = Path(os.environ.get("CLAUDE_SESSIES_DB", HOME / "claude-sessies" / "index.db"))
INDEX_VERSIE = 4  # ophogen als het parsen verandert: dan wordt alles opnieuw ingelezen

# ── Geheimen ──────────────────────────────────────────────────────────────────────────────────────

GEHEIMEN = [
    re.compile(r"sk-ant-[A-Za-z0-9_\-]{10,}"),
    re.compile(r"\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{20,}"),
    re.compile(r"\bgithub_pat_[A-Za-z0-9_]{20,}"),
    re.compile(r"\bsb_secret_[A-Za-z0-9_\-]{10,}"),
    re.compile(r"\bAKIA[0-9A-Z]{16}\b"),
    re.compile(r"\bAIza[0-9A-Za-z_\-]{30,}"),
    re.compile(r"\bxox[abpr]-[A-Za-z0-9\-]{10,}"),
    re.compile(r"\beyJ[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}"),
    re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?-----END [A-Z ]*PRIVATE KEY-----", re.S),
]
# sleutel=waarde of sleutel: waarde, waarbij alleen de waarde verdwijnt
GEHEIM_VELD = re.compile(
    r"(?i)\b([A-Z0-9_]*(?:password|passwd|wachtwoord|secret|token|api[_-]?key|apikey)[A-Z0-9_]*)"
    r"([\"']?\s*[:=]\s*[\"']?)([^\s\"',;]{6,})"
)


def verberg(tekst):
    for p in GEHEIMEN:
        tekst = p.sub("[verborgen]", tekst)
    return GEHEIM_VELD.sub(lambda m: f"{m.group(1)}{m.group(2)}[verborgen]", tekst)


# ── Transcripten lezen ────────────────────────────────────────────────────────────────────────────

HERINNERING = re.compile(r"<system-reminder>.*?</system-reminder>", re.S)
COMMANDO = re.compile(r"<command-name>(.*?)</command-name>.*?(?:<command-args>(.*?)</command-args>)?", re.S)
INTERNE_TAGS = re.compile(r"</?(?:command-message|command-name|command-args|local-command-stdout)>")


def schoon(tekst):
    tekst = HERINNERING.sub("", tekst)
    m = COMMANDO.search(tekst)
    if m and tekst.lstrip().startswith("<command-"):
        return f"/{m.group(1).lstrip('/')} {(m.group(2) or '').strip()}".strip()
    return INTERNE_TAGS.sub("", tekst).strip()


def regels(pad):
    """JSON-records van een transcript; halve of kapotte regels (sessie schrijft nog) worden overgeslagen."""
    try:
        with open(pad, encoding="utf-8", errors="replace") as f:
            for regel in f:
                try:
                    d = json.loads(regel)
                except ValueError:
                    continue
                if isinstance(d, dict):
                    yield d
    except OSError:
        return


def tool_kort(naam, invoer):
    """Eén regel over een tool-aanroep: wat er gebeurde, zonder de hele inhoud."""
    invoer = invoer if isinstance(invoer, dict) else {}
    for sleutel in ("description", "file_path", "command", "pattern", "url", "query", "prompt", "skill"):
        if invoer.get(sleutel):
            waarde = str(invoer[sleutel]).strip().splitlines()[0] if str(invoer[sleutel]).strip() else ""
            return f"{naam}: {waarde[:200]}"
    return naam


def berichten(pad, met_tools=False):
    """De chat als lijst (rol, tijd, tekst[, extra]); rol is 'jij', 'claude' of 'tool'.

    Bij tools: tekst is de korte regel, extra (alleen met_tools) de invoer en het begin van de uitkomst.
    """
    uit = []
    tools = {}
    for d in regels(pad):
        soort = d.get("type")
        if soort not in ("user", "assistant") or d.get("isSidechain") or d.get("isMeta"):
            continue
        tijd = d.get("timestamp", "")
        inhoud = (d.get("message") or {}).get("content")
        if soort == "user":
            if isinstance(inhoud, str):
                t = schoon(inhoud)
                if t:
                    uit.append({"rol": "jij", "tijd": tijd, "tekst": t})
                continue
            for blok in inhoud if isinstance(inhoud, list) else []:
                if not isinstance(blok, dict):
                    continue
                if blok.get("type") == "text":
                    t = schoon(blok.get("text", ""))
                    if t:
                        uit.append({"rol": "jij", "tijd": tijd, "tekst": t})
                elif blok.get("type") == "tool_result" and met_tools and blok.get("tool_use_id") in tools:
                    res = blok.get("content")
                    if isinstance(res, list):
                        res = "\n".join(x.get("text", "") for x in res if isinstance(x, dict) and x.get("type") == "text")
                    res = str(res or "")
                    tools[blok["tool_use_id"]]["uitkomst"] = res[:3000] + ("\n… (ingekort)" if len(res) > 3000 else "")
        else:
            for blok in inhoud if isinstance(inhoud, list) else []:
                if not isinstance(blok, dict):
                    continue
                if blok.get("type") == "text" and blok.get("text", "").strip():
                    uit.append({"rol": "claude", "tijd": tijd, "tekst": blok["text"].strip()})
                elif blok.get("type") == "tool_use":
                    b = {"rol": "tool", "tijd": tijd, "tekst": tool_kort(blok.get("name", "?"), blok.get("input")),
                         "naam": blok.get("name", "?"), "invoer": blok.get("input") or {}}
                    if met_tools:
                        tools[blok.get("id")] = b
                    uit.append(b)
    for b in uit:
        b["tekst"] = verberg(b["tekst"])
        if "uitkomst" in b:
            b["uitkomst"] = verberg(b["uitkomst"])
    return uit


def kenmerken(pad):
    """Titel, map en tijden van een sessie."""
    titel = ai_titel = cwd = None
    start = eind = None
    for d in regels(pad):
        soort = d.get("type")
        if soort == "custom-title" and d.get("customTitle"):
            titel = d["customTitle"]
        elif soort == "ai-title" and d.get("aiTitle"):
            ai_titel = d["aiTitle"]
        elif soort in ("user", "assistant") and not d.get("isSidechain"):
            cwd = cwd or d.get("cwd")
            t = d.get("timestamp")
            if t:
                start = start or t
                eind = t
    return {"titel": titel or ai_titel, "cwd": cwd, "start": start, "eind": eind}


def sessiebestanden():
    if not PROJECTEN.is_dir():
        return []
    uuid = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
    return sorted(p for p in PROJECTEN.glob("*/*.jsonl") if uuid.fullmatch(p.stem))


# ── Index ─────────────────────────────────────────────────────────────────────────────────────────

def verbind():
    DB.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    db = sqlite3.connect(DB, timeout=30, check_same_thread=False)
    db.row_factory = sqlite3.Row
    db.executescript("""
        CREATE TABLE IF NOT EXISTS sessies (
            id TEXT PRIMARY KEY, pad TEXT, project TEXT, cwd TEXT, titel TEXT, eerste_vraag TEXT,
            start TEXT, eind TEXT, vragen INTEGER, mtime REAL, grootte INTEGER, versie INTEGER);
        CREATE VIRTUAL TABLE IF NOT EXISTS teksten USING fts5(
            sessie UNINDEXED, nr UNINDEXED, rol UNINDEXED, tijd UNINDEXED, tekst,
            tokenize = 'unicode61 remove_diacritics 2');
    """)
    return db


_slot = threading.Lock()


def bijwerken(db, stil=True):
    """Leest alleen gewijzigde transcripten opnieuw in; verdwenen sessies gaan uit de index."""
    with _slot:
        if not PROJECTEN.is_dir():  # map (even) niet beschikbaar: index laten staan in plaats van leeg te gooien
            return 0, 0
        bekend = {r["id"]: r for r in db.execute("SELECT id, mtime, grootte, versie FROM sessies")}
        gezien = set()
        nieuw = 0
        for pad in sessiebestanden():
            sid = pad.stem
            gezien.add(sid)
            try:
                st = pad.stat()
            except OSError:
                continue
            r = bekend.get(sid)
            if r and r["mtime"] == st.st_mtime and r["grootte"] == st.st_size and r["versie"] == INDEX_VERSIE:
                continue
            k = kenmerken(pad)
            lijst = berichten(pad)
            vragen = [b for b in lijst if b["rol"] == "jij"]
            eerste = vragen[0]["tekst"] if vragen else ""
            with db:
                db.execute("DELETE FROM teksten WHERE sessie = ?", (sid,))
                db.executemany("INSERT INTO teksten (sessie, nr, rol, tijd, tekst) VALUES (?, ?, ?, ?, ?)",
                               [(sid, i, b["rol"], b["tijd"], b["tekst"]) for i, b in enumerate(lijst)])
                db.execute("INSERT OR REPLACE INTO sessies VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
                           (sid, str(pad), pad.parent.name, k["cwd"], " ".join(verberg(k["titel"] or eerste[:90]).split()), eerste[:2000],
                            k["start"], k["eind"], len(vragen), st.st_mtime, st.st_size, INDEX_VERSIE))
            nieuw += 1
            if not stil:
                print(f"  {sid[:8]}  {(k['titel'] or eerste)[:70]}", file=sys.stderr)
        weg = set(bekend) - gezien
        with db:
            for sid in weg:
                db.execute("DELETE FROM sessies WHERE id = ?", (sid,))
                db.execute("DELETE FROM teksten WHERE sessie = ?", (sid,))
        return nieuw, len(weg)


def zoekvraag(woorden):
    """Gewone woorden naar een FTS5-vraag: alle woorden moeten voorkomen; "zin tussen aanhalingstekens" als geheel,
    woord* voor alles wat zo begint."""
    uit = []
    for w in re.findall(r'"[^"]+"|[^\s"]+', woorden):
        if w.startswith('"'):
            uit.append(w)
        else:
            ster = w.endswith("*")
            w = w.strip("*")
            if w:
                uit.append(f'"{w}"' + ("*" if ster else ""))
    return " ".join(uit)


def zoek(db, woorden, limiet=50, project=None):
    vraag = zoekvraag(woorden)
    if not vraag:
        return []
    sql = """SELECT t.sessie, t.nr, t.rol, t.tijd, snippet(teksten, 4, '\x02', '\x03', ' … ', 18) AS stuk,
                    s.titel, s.project, s.eind
             FROM teksten t JOIN sessies s ON s.id = t.sessie
             WHERE teksten MATCH ?""" + (" AND s.project LIKE ?" if project else "") + """
             ORDER BY s.eind DESC, t.nr LIMIT ?"""
    args = [vraag] + ([f"%{project}%"] if project else []) + [limiet]
    try:
        return list(db.execute(sql, args))
    except sqlite3.OperationalError:
        return []


def sessies(db, limiet=50, project=None):
    sql = "SELECT * FROM sessies" + (" WHERE project LIKE ? OR cwd LIKE ?" if project else "") + " ORDER BY eind DESC LIMIT ?"
    args = ([f"%{project}%"] * 2 if project else []) + [limiet]
    return list(db.execute(sql, args))


def vind(db, deel):
    if len(deel) < 6:
        sys.exit("Geef minstens 6 tekens van het sessie-id.")
    rijen = list(db.execute("SELECT * FROM sessies WHERE id LIKE ? ORDER BY eind DESC", (deel + "%",)))
    if not rijen:
        sys.exit(f"Geen sessie gevonden voor '{deel}' (geef minstens 6 tekens van het id).")
    if len(rijen) > 1:
        sys.exit(f"'{deel}' past bij {len(rijen)} sessies; geef meer tekens.")
    return rijen[0]


# ── Weergave ──────────────────────────────────────────────────────────────────────────────────────

def tijdstip(iso, lang=False):
    if not iso:
        return ""
    try:
        t = datetime.fromisoformat(iso.replace("Z", "+00:00")).astimezone()
    except ValueError:
        return iso
    return t.strftime("%d-%m-%Y %H:%M" if lang else "%d-%m %H:%M")


def project_naam(rij):
    return (rij["cwd"] or rij["project"] or "").replace("/ai/workspace/", "").replace("/ai/workspace", "workspace") or "?"


def markdown(rij, met_tools=True):
    lijst = berichten(rij["pad"], met_tools=met_tools)
    uit = [f"# {rij['titel'] or 'Sessie'}", "",
           f"- Sessie: `{rij['id']}`", f"- Map: `{rij['cwd'] or rij['project']}`",
           f"- Van {tijdstip(rij['start'], True)} tot {tijdstip(rij['eind'], True)}", ""]
    for b in lijst:
        if b["rol"] == "tool":
            if met_tools:
                uit.append(f"> 🔧 {b['tekst']}")
                uit.append("")
            continue
        kop = "## Jij" if b["rol"] == "jij" else "## Claude"
        uit += [f"{kop} · {tijdstip(b['tijd'])}", "", b["tekst"], ""]
    return "\n".join(uit)


def overdracht(rij):
    """Korte notitie om in een nieuwe sessie verder te gaan: geen hele chat, wel de draad."""
    lijst = berichten(rij["pad"])
    vragen = [b for b in lijst if b["rol"] == "jij"]
    antwoorden = [b for b in lijst if b["rol"] == "claude"]
    bestanden, commits = [], []
    for b in lijst:
        if b["rol"] != "tool":
            continue
        inv = b.get("invoer") or {}
        if b["naam"] in ("Edit", "Write", "MultiEdit", "NotebookEdit") and inv.get("file_path"):
            if inv["file_path"] not in bestanden:
                bestanden.append(inv["file_path"])
        if b["naam"] == "Bash" and "git commit" in str(inv.get("command", "")):
            m = re.search(r"-m\s+(?:\"\$\(cat <<'?EOF'?\n)?[\"']?([^\n\"']+)", inv["command"])
            if m:
                commits.append(m.group(1).strip())

    def kort(t, n):
        t = t.strip()
        return t if len(t) <= n else t[:n].rstrip() + " …"

    uit = [f"# Overdracht: {rij['titel'] or 'sessie'}", "",
           f"Vorige sessie `{rij['id']}` in `{rij['cwd'] or rij['project']}`, "
           f"{tijdstip(rij['start'], True)} tot {tijdstip(rij['eind'], True)}, {len(vragen)} vragen.",
           f"Volledige chat: `claude-sessies toon {rij['id'][:8]}`; hervatten in een terminal: "
           f"`cd {shlex.quote(rij['cwd'] or '.')} && claude --resume {rij['id']}`.", "",
           "## Waar het om begon", "", kort(vragen[0]["tekst"], 1500) if vragen else "(geen vraag)", ""]
    if len(vragen) > 1:
        uit += ["## Laatste vragen", ""] + [f"- {tijdstip(b['tijd'])}: {kort(b['tekst'], 400)}" for b in vragen[-4:]] + [""]
    if bestanden:
        uit += ["## Gewijzigde bestanden", ""] + [f"- `{p}`" for p in bestanden[-40:]] + [""]
    if commits:
        uit += ["## Commits", ""] + [f"- {c}" for c in commits[-15:]] + [""]
    if antwoorden:
        uit += ["## Laatste antwoord van Claude", "", kort(antwoorden[-1]["tekst"], 3000), ""]
    return "\n".join(uit)


