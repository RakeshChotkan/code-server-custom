#!/usr/bin/env python3
"""gemini-review: laat Gemini (Antigravity CLI, agy) code reviewen of een voorstel beoordelen.
Alleen lezen: agy draait in plan-modus, krijgt alle code in de prompt en hoeft geen tools te
gebruiken. Werkt in een git-repository.

    gemini-review                      de niet-gecommitte wijzigingen (ook nieuwe bestanden)
    gemini-review <git-diff-args>      bv. --cached, of main...HEAD -- ttool tests
    gemini-review --alles              de hele codebase (paden uit .gemini-review)
    gemini-review --advies VOORSTEL.md [pad ...]
                                       second opinion op een voorstel, met de genoemde
                                       bestanden en een kaart van de hele codebase als
                                       context (Gemini mag losse bestanden lezen)
    gemini-review --samenvoegen NAAM=bevindingen.json NAAM=... [--titel TEKST]
                                       bevindingen uit meer bronnen (bv. Gemini en Claude)
                                       samenvoegen tot één rapport; wat meer bronnen vonden,
                                       staat erbij

Opties: --opnieuw (cache negeren), --parallel N (standaard 2), --droog (alleen tonen
welke aanroepen en hoe groot, zonder Gemini aan te roepen).
Model: GEMINI_REVIEW_MODEL (standaard gemini-3.8-flash-high; lijst: agy models).

Zuinig met tokens: elke aanroep kost ~13.000 tokens vaste overhead, dus zo min mogelijk,
zo groot mogelijke aanroepen (tot ~110 KB code, de grens van één argument); geen diff-
tekens voor een volledige review; geen tools; hooguit 15 bevindingen per deel; en bij
--alles worden alleen de bestanden verstuurd die sinds de vorige review veranderd zijn: de
bevindingen van de andere komen uit de cache per bestand.

Uitvoer in .git/gemini-review/<tijd>-<soort>/: rapport.md (gesorteerd op ernst),
bevindingen.json en per aanroep de ruwe JSON. Exit 0 = gelukt, 1 = een deel mislukt,
2 = verkeerde aanroep, 3 = niet ingelogd of quotum op.

Per repository (optioneel) een bestand .gemini-review:

    [review]
    paden = src tests            ; voor --alles (standaard: alle bestanden in git)
    context = Korte beschrijving van het project en de belangrijkste regels.
    afspraken = CLAUDE.md        ; voor de samenhangronde en --advies; meer bestanden
                                 ; mag, gescheiden door spaties
"""
import ast
import concurrent.futures
import configparser
import datetime
import difflib
import hashlib
import json
import os
import re
import signal
import subprocess
import sys
import threading

AGY = next((p for p in ("/usr/local/bin/agy", os.path.expanduser("~/.local/bin/agy"))
            if os.access(p, os.X_OK)), "agy")
MODEL = os.environ.get("GEMINI_REVIEW_MODEL", "gemini-3.8-flash-high")
VERSIE = "2"                    # verhogen als de prompts veranderen: de cache vervalt dan
MAX_DEEL = 110000               # bytes code per aanroep (één argument mag max. 128 KB zijn)
TIJD = 20 * 60                  # seconden per aanroep
MAX_PROMPT = 127000             # bytes: de grens van één argument (128 KB) met wat marge
LOPEND, SLOT = set(), threading.Lock()      # lopende agy-processen, om te stoppen bij Stop
GESTOPT = threading.Event()                 # gezet bij Stop: geen nieuwe pogingen meer

BEVINDING = {
    "type": "object",
    "properties": {
        "bestand": {"type": "string"},
        "regel": {"type": "integer"},
        "ernst": {"type": "string", "enum": ["hoog", "middel", "laag"]},
        "soort": {"type": "string", "enum": ["fout", "beveiliging", "randgeval",
                                             "afspraak", "onderhoud", "eenvoud"]},
        "probleem": {"type": "string"},
        "voorstel": {"type": "string"},
    },
    "required": ["bestand", "regel", "ernst", "soort", "probleem", "voorstel"],
}
SCHEMA_REVIEW = {"type": "object", "required": ["bevindingen"],
                 "properties": {"bevindingen": {"type": "array", "items": BEVINDING}}}
SCHEMA_ADVIES = {
    "type": "object", "required": ["punten"],
    "properties": {"punten": {"type": "array", "items": {
        "type": "object",
        "properties": {
            "onderwerp": {"type": "string"},
            "ernst": {"type": "string", "enum": ["hoog", "middel", "laag"]},
            "soort": {"type": "string", "enum": ["risico", "randgeval", "alternatief",
                                                 "afspraak", "vraag"]},
            "toelichting": {"type": "string"},
            "voorstel": {"type": "string"},
        },
        "required": ["onderwerp", "ernst", "soort", "toelichting", "voorstel"]}}},
}

REGELS = """Antwoord in het Nederlands. Gebruik geen tools en voer niets uit: alles wat je
nodig hebt staat in deze prompt. Noem alleen echte problemen (geen smaak, geen opmaak die een
linter al vangt), hooguit 15, de ernstigste eerst; niets gevonden = een lege lijst. Per
bevinding: het bestand en het regelnummer zoals hieronder vermeld, ernst, soort, het probleem
in één tot drie zinnen en een concreet voorstel (kort; code alleen als het echt helpt)."""


class Stop(Exception):
    """Niet ingelogd of quotum op: verder gaan heeft geen zin."""


def git(*args, binair=False):
    uit = subprocess.run(["git"] + list(args), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if uit.returncode != 0:
        raise SystemExit("gemini-review: git %s: %s" % (" ".join(args),
                                                        uit.stderr.decode().strip()))
    return uit.stdout if binair else uit.stdout.decode("utf-8", "replace")


def heeft_commit():
    return subprocess.run(["git", "rev-parse", "--verify", "-q", "HEAD"], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL).returncode == 0


def instellingen():
    c = configparser.ConfigParser(inline_comment_prefixes=(";", "#"))
    c.read(".gemini-review", encoding="utf-8")
    r = c["review"] if c.has_section("review") else {}
    return {"paden": r.get("paden", "").split(), "context": r.get("context", "").strip(),
            "afspraken": r.get("afspraken", "").strip()}


def lees(pad):
    try:
        with open(pad, encoding="utf-8") as f:
            return f.read()
    except (OSError, UnicodeDecodeError):
        return None


def lees_afspraken(paden):
    """De afspraken uit een of meer bestanden (gescheiden door spaties of regeleindes).
    Bij meer dan één staat de naam van elk bestand erboven; een bestand dat er niet is,
    wordt overgeslagen."""
    gevonden = [(pad, lees(pad)) for pad in paden.split()]
    gevonden = [(pad, tekst) for pad, tekst in gevonden if tekst is not None]
    if len(gevonden) == 1:
        return gevonden[0][1]
    return "\n\n".join("=== %s ===\n%s" % (pad, tekst) for pad, tekst in gevonden)


# ---------------------------------------------------------------- delen maken

def genummerd(pad, tekst, eerste=1):
    regels = tekst.splitlines()
    return "=== %s\n%s\n" % (pad, "\n".join("%d|%s" % (eerste + i, r)
                                            for i, r in enumerate(regels)))


def code_delen(bestanden):
    """Volledige bestanden met regelnummers, in delen van hooguit MAX_DEEL; een te groot
    bestand wordt op regelgrenzen geknipt. Bestanden van één map blijven bij elkaar.
    Geeft [(inhoud, {paden})]."""
    stukken = []
    for pad in bestanden:
        tekst = lees(pad)
        if not tekst or "\0" in tekst:
            continue
        regels = tekst.splitlines()
        blok, start, maat = [], 1, 0
        for i, r in enumerate(regels, 1):
            blok.append(r)
            maat += len(r.encode()) + 8            # + regelnummer en scheidingsteken
            if maat > MAX_DEEL - 2000:
                stukken.append((genummerd("%s (regels %d-%d)" % (pad, start, i),
                                          "\n".join(blok), start), pad))
                blok, start, maat = [], i + 1, 0
        if blok:
            naam = pad if start == 1 else "%s (regels %d-%d)" % (pad, start, len(regels))
            stukken.append((genummerd(naam, "\n".join(blok), start), pad))
    return bundel(stukken)


def diff_delen(diff):
    """Een diff per bestand, gebundeld tot delen van hooguit MAX_DEEL."""
    stukken = [s for s in re.split(r"(?m)^(?=diff --git )", diff) if s.strip()]
    uit = []
    for s in stukken:
        while len(s.encode()) > MAX_DEEL:     # één enorm bestand: op regelgrenzen knippen
            knip = s.rfind("\n", 0, MAX_DEEL - 2000)
            if knip < 0:                      # één regel zonder einde: hard knippen
                knip = MAX_DEEL - 2001
            uit.append(s[:knip + 1])
            s = s[knip + 1:]
        uit.append(s)
    return [inhoud for inhoud, _ in bundel([(s, None) for s in uit])]


def bundel(stukken):
    """[(tekst, pad)] -> [(inhoud, {paden})], in volgorde, elk deel hooguit MAX_DEEL."""
    delen, huidig, paden = [], "", set()
    for s, pad in stukken:
        if huidig and len((huidig + s).encode()) > MAX_DEEL:
            delen.append((huidig, paden))
            huidig, paden = "", set()
        huidig += s
        paden.add(pad)
    if huidig:
        delen.append((huidig, paden))
    return delen


# ---------------------------------------------------------------- cache per bestand
# Bij --alles worden de bevindingen ook per bestand bewaard (sleutel: model, promptversie,
# context, pad en inhoud). Een volgende volledige review stuurt alleen de bestanden die
# veranderd zijn; de rest komt hieruit. Zo schuiven er geen deelgrenzen op.

def bestand_sleutel(context, pad):
    inhoud = lees(pad) or ""
    return hashlib.sha256("\0".join((VERSIE, MODEL, context, pad, inhoud)).encode()).hexdigest()


def schoon_pad(naam):
    """'./x.py (regels 1-9)' -> 'x.py'; '.github/...' blijft heel."""
    naam = re.sub(r"\s*\(regels [0-9-]+\)$", "", naam.strip())
    return naam[2:] if naam.startswith("./") else naam


def bij_bestand(b, paden):
    """Het pad uit `paden` waar bevinding b bij hoort ('x.py (regels 1-9)' -> 'x.py')."""
    naam = schoon_pad(b.get("bestand", ""))
    if naam in paden:
        return naam
    for p in sorted(paden):
        if p.endswith("/" + naam) or naam.endswith("/" + p):
            return p
    return sorted(paden)[0]


def overzicht(bestanden):
    """Compacte kaart van de code voor de samenhangronde: per bestand de imports en de
    functies/klassen met hun parameters (Python), of de functies (shell)."""
    regels = []
    for pad in bestanden:
        tekst = lees(pad)
        if not tekst:
            continue
        if pad.endswith(".py") or tekst.startswith("#!/usr/bin/env python"):
            try:
                boom = ast.parse(tekst)
            except SyntaxError:
                continue
            imp, defs = [], []
            for n in boom.body:
                if isinstance(n, ast.Import):
                    imp += [a.name for a in n.names]
                elif isinstance(n, ast.ImportFrom):
                    imp.append("%s%s" % ("." * n.level, n.module or ""))
                elif isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
                    if isinstance(n, ast.ClassDef):
                        defs.append("class %s" % n.name)
                    else:
                        defs.append("%s(%s):%d" % (n.name, ", ".join(a.arg for a in n.args.args),
                                                   n.lineno))
            regels.append("%s | import %s | %s" % (pad, ", ".join(imp), "; ".join(defs)))
        elif tekst.startswith("#!") and "sh" in tekst.split("\n", 1)[0]:
            fn = re.findall(r"(?m)^\s*([A-Za-z_][\w-]*)\s*\(\)\s*\{", tekst)
            regels.append("%s | shell | %s" % (pad, "; ".join(fn)))
    return "\n".join(regels)


# ---------------------------------------------------------------- Gemini aanroepen

def vraag(prompt, schema, map_, naam, cache, opnieuw):
    """Eén aanroep van agy; geeft (structured_output, verbruik, uit_cache). Probeert één keer
    opnieuw bij een lege of ongeldige uitvoer. Met opnieuw wordt de cache niet gelezen (wel
    bijgewerkt)."""
    if len(prompt.encode()) > MAX_PROMPT:
        raise RuntimeError("prompt te groot (%d KB, max. %d KB); maak de invoer kleiner"
                           % (len(prompt.encode()) // 1024, MAX_PROMPT // 1024))
    sleutel = hashlib.sha256((VERSIE + MODEL + json.dumps(schema) + prompt).encode()).hexdigest()
    cpad = os.path.join(cache, sleutel + ".json")
    if os.path.exists(cpad) and not opnieuw:
        with open(cpad, encoding="utf-8") as f:
            data = json.load(f)
        bewaar(map_, naam, data)
        return data["structured_output"], data.get("usage", {}), True
    fout, vraagtekst = "", prompt
    for _ in range(2):
        if GESTOPT.is_set():
            raise Stop("gestopt")
        p = subprocess.Popen([AGY, "--model", MODEL, "--mode", "plan", "--output-format", "json",
                              "--json-schema", json.dumps(schema), "--print-timeout",
                              "%dm" % (TIJD // 60), "-p", vraagtekst],
                             stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE, start_new_session=True)
        with SLOT:
            LOPEND.add(p)
        try:
            # stdout is alleen de JSON; stderr (waarschuwingen, meldingen) apart
            uit, err = (x.decode("utf-8", "replace") for x in p.communicate(timeout=TIJD + 60))
        except subprocess.TimeoutExpired:
            stop_proces(p)
            p.communicate()
            fout = "time-out na %d minuten" % (TIJD // 60)
            continue
        finally:
            with SLOT:
                LOPEND.discard(p)
        if GESTOPT.is_set():
            raise Stop("gestopt")
        try:
            data = json.loads(uit)
        except ValueError:
            try:                            # voor de zekerheid: eerste JSON-object in de uitvoer
                data = json.JSONDecoder().raw_decode(uit[uit.index("{"):])[0]
            except ValueError:
                data = {}
        if data.get("status") == "SUCCESS" and isinstance(data.get("structured_output"), dict):
            bewaar(map_, naam, data)
            with open(cpad, "w", encoding="utf-8") as f:
                json.dump(data, f)
            return data["structured_output"], data.get("usage", {}), False
        # Geen geldig antwoord: alleen dan zoeken naar login- en quotummeldingen (in een
        # geldig antwoord kan zo'n woord, of een regelnummer als 429, gewoon voorkomen).
        melding = ((str(data.get("error") or data.get("response") or "") if data else uit)
                   + "\n" + err).strip()
        if re.search(r"Authentication required|authentication (failed|timed out)", melding):
            raise Stop("niet ingelogd: start 'agy' in een terminal en log in met het "
                       "Google-account met Google AI Pro")
        if re.search(r"RESOURCE_EXHAUSTED|quota (exceeded|exhausted|reached)|"
                     r"rate.?limit|\b429\b", melding, re.I):
            raise Stop("quotum op of te veel verzoeken: %s" % melding[-300:])
        fout = ("status %s: %s" % (data.get("status"), melding[-300:]) if data
                else melding[-300:] or "geen uitvoer")
        if re.search(r"output token limit|cut off", melding, re.I):
            # Antwoord te lang: de tweede poging vraagt om een korter antwoord (de cache
            # houdt de sleutel van de oorspronkelijke prompt).
            vraagtekst = prompt + ("\n\nLET OP: je vorige antwoord was te lang. Geef nu hooguit "
                                   "8 bevindingen, met elk probleem en voorstel in één zin.")
    raise RuntimeError(fout)


def stop_proces(p):
    try:
        os.killpg(p.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass


def bewaar(map_, naam, data):
    with open(os.path.join(map_, naam + ".json"), "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=1)


