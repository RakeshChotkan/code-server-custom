# ---------------------------------------------------------------- rapport

ERNST = {"hoog": 0, "middel": 1, "laag": 2}


def rapport(map_, titel, bevindingen, kop):
    uniek, gezien = [], set()
    for b in bevindingen:
        sleutel = (b.get("bestand", b.get("onderwerp", "")), b.get("regel"),
                   re.sub(r"\W+", " ", b.get("probleem", b.get("toelichting", "")))[:60].lower())
        if sleutel not in gezien:
            gezien.add(sleutel)
            uniek.append(b)
    for b in uniek:
        if "bestand" in b:
            b["regel"] = b.get("regel") or 0
    uniek.sort(key=lambda b: (ERNST.get(b["ernst"], 3), -len(b.get("bron", [])),
                              b.get("bestand", ""), b.get("regel") or 0))
    with open(os.path.join(map_, "bevindingen.json"), "w", encoding="utf-8") as f:
        json.dump(uniek, f, ensure_ascii=False, indent=1)
    r = ["# %s" % titel, ""] + kop + [""]
    if not uniek:
        r.append("Geen bevindingen.")
    for i, b in enumerate(uniek, 1):
        bron = "  \n   *Gevonden door:* %s" % " en ".join(b["bron"]) if b.get("bron") else ""
        if "bestand" in b:
            r.append("%d. **%s** `%s:%s` (%s) %s  \n   *Voorstel:* %s%s"
                     % (i, b["ernst"], b["bestand"], b["regel"], b["soort"], b["probleem"],
                        b["voorstel"], bron))
        else:
            r.append("%d. **%s** %s (%s): %s  \n   *Voorstel:* %s"
                     % (i, b["ernst"], b["onderwerp"], b["soort"], b["toelichting"],
                        b["voorstel"]))
    pad = os.path.join(map_, "rapport.md")
    with open(pad, "w", encoding="utf-8") as f:
        f.write("\n".join(r) + "\n")
    return pad, uniek


def zelfde(a, b):
    """Gaat het waarschijnlijk om hetzelfde probleem? Zelfde bestand, regels dicht bij elkaar,
    en dezelfde soort of een gelijkende omschrijving."""
    if "bestand" not in a or "bestand" not in b:     # punten van --advies: op onderwerp
        return a.get("onderwerp") == b.get("onderwerp")
    if a.get("bestand") != b.get("bestand") or \
            abs((a.get("regel") or 0) - (b.get("regel") or 0)) > 3:
        return False
    # Vergelijk op woorden, niet op letters (letters geven bij elke Nederlandse zin al snel
    # 0,3). Liever een dubbel punt twee keer tonen dan twee verschillende samenvoegen.
    woorden = [re.findall(r"\w{3,}", x.get("probleem", "").lower()) for x in (a, b)]
    tekst = difflib.SequenceMatcher(None, *woorden).ratio()
    zelfde_regel = (a.get("regel") or 0) == (b.get("regel") or 0)
    return tekst >= 0.4 or (zelfde_regel and a.get("soort") == b.get("soort"))


def samenvoegen(bronnen):
    """[(naam, [bevindingen])] -> één lijst; dubbele bevindingen krijgen alle bronnen en de
    hoogste ernst."""
    uit = []
    for naam, lijst in bronnen:
        for b in lijst:
            b = dict(b)
            if "bestand" in b:
                b["bestand"] = schoon_pad(b["bestand"])
                b["regel"] = b.get("regel") or 0
            gelijk = next((u for u in uit if zelfde(u, b)), None)
            if gelijk is None:
                b["bron"] = [naam]
                uit.append(b)
            else:
                if naam not in gelijk["bron"]:
                    gelijk["bron"].append(naam)
                if ERNST.get(b["ernst"], 3) < ERNST.get(gelijk["ernst"], 3):
                    gelijk["ernst"] = b["ernst"]
    return uit


# ---------------------------------------------------------------- hoofdprogramma

def main(argv):
    args, opnieuw, parallel, modus, voorstel, droog = [], False, 2, "diff", None, False
    titel_eigen = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--alles":
            modus = "alles"
        elif a == "--opnieuw":
            opnieuw = True
        elif a == "--droog":
            droog = True
        elif a == "--parallel" and i + 1 < len(argv):
            parallel = max(1, int(argv[i + 1]))
            i += 1
        elif a == "--samenvoegen":
            modus = "samenvoegen"
        elif a == "--titel" and i + 1 < len(argv):
            titel_eigen = argv[i + 1]
            i += 1
        elif a == "--advies" and i + 1 < len(argv):
            modus, voorstel = "advies", argv[i + 1]
            i += 1
        elif a in ("-h", "--help"):
            print(__doc__)
            return 0
        else:
            args.append(a)
        i += 1

    os.chdir(git("rev-parse", "--show-toplevel").strip())
    inst = instellingen()
    gitmap = os.path.abspath(git("rev-parse", "--git-dir").strip())
    basis = os.path.join(gitmap, "gemini-review")
    cache = os.path.join(basis, "cache")
    bcache = os.path.join(cache, "bestanden")
    os.makedirs(cache, exist_ok=True)
    stempel = os.path.join(basis, datetime.datetime.now().strftime("%Y%m%d-%H%M%S-") + modus)
    map_, n = stempel, 1
    while os.path.exists(map_):         # twee runs in dezelfde seconde
        n += 1
        map_ = "%s-%d" % (stempel, n)
    os.makedirs(map_)
    afspraken = lees_afspraken(inst["afspraken"])

    if modus == "samenvoegen":
        bronnen = []
        for a in args:
            naam, is_, pad = a.partition("=")
            if not is_ or not naam or not pad:
                print("gemini-review: %s: verwacht NAAM=bevindingen.json" % a)
                return 2
            try:
                with open(pad, encoding="utf-8") as f:
                    data = json.load(f)
            except (OSError, ValueError) as e:
                print("gemini-review: kan %s niet lezen: %s" % (a, e))
                return 2
            bronnen.append((naam, (data.get("bevindingen") or data.get("punten") or [])
                            if isinstance(data, dict)
                            else data))
        if not bronnen:
            print("gemini-review: geef bronnen als NAAM=bevindingen.json")
            return 2
        lijst = samenvoegen(bronnen)
        meer = sum(1 for b in lijst if len(b["bron"]) > 1)
        kop = ["Bronnen: %s · %s" % (", ".join("%s (%d)" % (n, len(l)) for n, l in bronnen),
                                     datetime.datetime.now().strftime("%d-%m-%Y %H:%M")),
               "Na samenvoegen: %d punten, waarvan %d door meer bronnen gevonden"
               % (len(lijst), meer)]
        pad, _ = rapport(map_, titel_eigen or "Samengevoegde review", lijst, kop)
        print("gemini-review: %d punten (%d door meer bronnen), rapport: %s"
              % (len(lijst), meer, pad))
        return 0

    taken = []          # (naam, prompt, schema, paden of None)
    bekend, ongewijzigd = [], 0     # --alles: bevindingen uit de cache per bestand
    sleutels = {}                   # --alles: cachesleutel per bestand, bij het begin bepaald
    if modus == "advies":
        tekst = lees(voorstel)
        if tekst is None:
            print("gemini-review: kan %s niet lezen" % voorstel)
            return 2
        code = "".join(genummerd(p, lees(p) or "") for p in args)
        if len(code.encode()) > MAX_DEEL:
            print("gemini-review: de meegegeven bestanden zijn samen te groot (max. ~110 KB)")
            return 2
        bestanden = [b for b in git("ls-files", "-z", "--", *(inst["paden"] or ["."]))
                     .split("\0") if b and os.path.isfile(b)]
        taken.append(("advies", advies_prompt(inst["context"], afspraken, tekst, code,
                                              overzicht(bestanden)), SCHEMA_ADVIES, None))
    elif modus == "alles":
        bestanden = [b for b in git("ls-files", "-z", "--", *(inst["paden"] or ["."]))
                     .split("\0") if b and os.path.isfile(b)]
        os.makedirs(bcache, exist_ok=True)
        nieuw = []
        for b in bestanden:
            sleutels[b] = bestand_sleutel(inst["context"], b)
            cpad = os.path.join(bcache, sleutels[b] + ".json")
            if os.path.exists(cpad) and not opnieuw:
                with open(cpad, encoding="utf-8") as f:
                    bekend += json.load(f)
                ongewijzigd += 1
            else:
                nieuw.append(b)
        for n, (inhoud, paden) in enumerate(code_delen(nieuw), 1):
            taken.append(("deel-%02d" % n, review_prompt(inst["context"], inhoud, "code"),
                          SCHEMA_REVIEW, paden))
        kaart = overzicht(bestanden)
        taken.append(("samenhang", samenhang_prompt(inst["context"], afspraken, kaart),
                      SCHEMA_REVIEW, None))
    else:
        if args:
            diff = git("diff", *args)
        else:
            diff = git("diff", "HEAD") if heeft_commit() else git("diff", "--cached")
            for b in git("ls-files", "--others", "--exclude-standard", "-z").split("\0"):
                if b:
                    d = subprocess.run(["git", "diff", "--no-index", "--", "/dev/null", b],
                                       stdout=subprocess.PIPE)
                    diff += d.stdout.decode("utf-8", "replace")
        if not diff.strip():
            print("gemini-review: geen wijzigingen om te reviewen")
            return 0
        for n, inhoud in enumerate(diff_delen(diff), 1):
            taken.append(("deel-%02d" % n, review_prompt(inst["context"], inhoud, "diff"),
                          SCHEMA_REVIEW, None))

    if droog:
        os.rmdir(map_)
        for n, p, s, _ in taken:
            print("  %-10s %4d KB" % (n, len(p.encode()) // 1024))
        print("gemini-review: %d aanroep(en), model %s (droog: niets verstuurd)%s"
              % (len(taken), MODEL, ", %d bestanden ongewijzigd (uit cache)" % ongewijzigd
                 if ongewijzigd else ""))
        return 0
    print("gemini-review: %d aanroep(en), model %s, map %s%s"
          % (len(taken), MODEL, map_, "; %d bestanden ongewijzigd (uit cache)" % ongewijzigd
             if ongewijzigd else ""), flush=True)
    resultaten, fouten, tokens, uit_cache = list(bekend), [], 0, 0
    per_bestand, mislukt = {}, set()        # --alles: bevindingen per bestand, voor de cache
    pool = concurrent.futures.ThreadPoolExecutor(max_workers=parallel)
    lopend = {pool.submit(vraag, p, s, map_, n, cache, opnieuw): (n, paden)
              for n, p, s, paden in taken}
    try:
        for f in concurrent.futures.as_completed(lopend):
            naam, paden = lopend[f]
            try:
                uit, verbruik, gecached = f.result()
            except Stop as e:
                GESTOPT.set()
                print("gemini-review: gestopt, %s" % e)
                return 3
            except Exception as e:      # een deel mislukt: de rest gaat door
                fouten.append("%s: %s" % (naam, e))
                mislukt |= paden or set()
                print("  %-10s MISLUKT: %s" % (naam, e), flush=True)
                continue
            lijst = uit.get("bevindingen", uit.get("punten", []))
            if paden:
                for pad in paden:
                    per_bestand.setdefault(pad, [])
                for b in lijst:
                    b["bestand"] = bij_bestand(b, paden)
                    per_bestand[b["bestand"]].append(b)
            resultaten += lijst
            uit_cache += gecached
            tokens += 0 if gecached else verbruik.get("total_tokens", 0)
            print("  %-10s %d punt(en)%s" % (naam, len(lijst), " (uit cache)" if gecached else ""),
                  flush=True)
    finally:
        pool.shutdown(wait=False, cancel_futures=True)
        with SLOT:
            for p in list(LOPEND):
                stop_proces(p)

    # Cache per bestand: alleen bestanden waarvan elk deel gelukt is (een groot bestand kan
    # over meer delen verdeeld zijn).
    for pad, lijst in per_bestand.items():
        if pad not in mislukt:
            with open(os.path.join(bcache, sleutels[pad] + ".json"), "w", encoding="utf-8") as f:
                json.dump(lijst, f, ensure_ascii=False)

    nu = datetime.datetime.now().strftime("%d-%m-%Y %H:%M")
    commit = git("rev-parse", "--short", "HEAD").strip() if heeft_commit() else "(geen commit)"
    kop = ["Model: %s · commit %s · %s" % (MODEL, commit, nu),
           "Aanroepen: %d (%d uit cache) · tokens deze keer: %d" % (len(taken), uit_cache, tokens)]
    if ongewijzigd:
        kop.append("Ongewijzigde bestanden uit de cache: %d" % ongewijzigd)
    if fouten:
        kop.append("**Mislukt:** " + "; ".join(fouten))
    titel = {"advies": "Second opinion van Gemini op %s" % voorstel,
             "alles": "Review van de hele codebase door Gemini",
             "diff": "Review van de wijzigingen door Gemini"}[modus]
    pad, uniek = rapport(map_, titel, resultaten, kop)
    print("gemini-review: %d punt(en), %d tokens, rapport: %s" % (len(uniek), tokens, pad))
    if modus != "alles":
        print()
        print(lees(pad))
    return 1 if fouten else 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
